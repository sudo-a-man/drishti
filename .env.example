# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The app runs in DEMO mode (fake data, no auth, no payments) until these are set.

# --- Supabase: create a project at https://supabase.com ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role is SERVER-ONLY (worker + webhooks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth: configure the client in the Supabase dashboard
#     (Authentication -> Providers -> Google), using your OWN Google Cloud app.
#     No key goes here; Supabase stores it.

# --- Razorpay: create at https://razorpay.com. Use TEST keys until launch. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Resend: transactional email from your OWN verified domain ---
RESEND_API_KEY=
EMAIL_FROM="Drishti <noreply@yourdomain.com>"

# --- Market data: Fyers (https://fyers.in). Create an app in the Fyers API
#     dashboard to get your App ID and Secret ID. These are the vars the code
#     actually reads (see lib/feed/fyers.ts). After setting them, authorize once
#     at /api/fyers/login. The redirect URI is hardcoded to
#     http://127.0.0.1:3000/api/fyers/callback, so register that EXACT URI on the
#     Fyers app and open the site at 127.0.0.1:3000 when authorizing. The token is
#     time-limited and cached server-side in .fyers-token.json; re-authorize when
#     it expires.
FYERS_APP_ID=
FYERS_SECRET_ID=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
