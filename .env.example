# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The app runs in DEMO mode (fake data, no auth, no payments) until these are set.

# --- Supabase: create a project at https://supabase.com ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role is SERVER-ONLY (worker + webhooks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth: configure the client in the Supabase dashboard
#     (Authentication -> Providers -> Google), using your OWN Google Cloud app.
#     No key goes here; Supabase stores it.

# --- Razorpay: create at https://razorpay.com. Use TEST keys until launch. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Resend: transactional email from your OWN verified domain ---
RESEND_API_KEY=
EMAIL_FROM="Lumetra <noreply@yourdomain.com>"

# --- Market data: Dhan (free). Open an account at dhan.co, then generate an
#     API access token in the DhanHQ dashboard. PERSONAL USE ONLY — do not
#     redistribute raw ticks. The token is time-limited; regenerate when it expires.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
